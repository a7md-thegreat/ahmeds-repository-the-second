<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Al Majlis Digital</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --sand: #F5F5DC;
            --gold: #D4AF37;
            --teal: #008080;
            --white: #FFFFFF;
            --zayed-green: #007A33;
            --uae-red: #FF0000;
            --glass: rgba(255, 255, 255, 0.6);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, var(--sand) 0%, #E8E8C3 100%);
            color: #333;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            opacity: 0;
            animation: fadeIn 1.2s ease-out forwards;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        header {
            padding: 2rem;
            text-align: center;
            border-bottom: 1px solid var(--gold);
            background: var(--glass);
            backdrop-filter: blur(10px);
        }

        header h1 {
            font-weight: 300;
            letter-spacing: 4px;
            color: var(--teal);
            text-transform: uppercase;
        }

        /* Dashboard Grid */
        .dashboard-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            padding: 2rem;
            max-width: 1200px;
            margin: 0 auto;
            flex-grow: 1;
        }

        /* Glass Cards */
        .card {
            background: var(--glass);
            backdrop-filter: blur(15px);
            border: 2px solid var(--gold);
            border-radius: 15px;
            padding: 1.5rem;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .card:hover {
            box-shadow: 0 0 20px rgba(0, 128, 128, 0.4);
            border-color: var(--teal);
        }

        .card h2 {
            margin-bottom: 1rem;
            font-weight: 400;
            color: var(--teal);
            border-bottom: 1px solid rgba(212, 175, 55, 0.3);
            padding-bottom: 0.5rem;
        }

        /* Karam List Styles */
        .karam-input-group {
            display: flex;
            gap: 10px;
            margin-bottom: 1rem;
        }

        input[type="text"] {
            flex: 1;
            padding: 10px;
            border: 1px solid var(--gold);
            border-radius: 5px;
            background: rgba(255,255,255,0.8);
        }

        button {
            padding: 10px 20px;
            background: var(--gold);
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            transition: transform 0.1s, background 0.3s;
            /* Mashrabiya pattern emulation */
            background-image: radial-gradient(circle, transparent 20%, var(--gold) 20%, var(--gold) 80%, transparent 80%, transparent), radial-gradient(circle, transparent 20%, var(--gold) 20%, var(--gold) 80%, transparent 80%, transparent) 25px 25px;
            background-size: 50px 50px;
            background-color: #b8860b;
        }

        button:active {
            transform: scale(0.95);
        }

        ul { list-style: none; }
        li {
            padding: 8px;
            margin: 5px 0;
            background: rgba(255,255,255,0.5);
            border-radius: 4px;
            cursor: pointer;
            user-select: none;
            transition: background 0.2s;
        }
        li.completed { text-decoration: line-through; color: #888; }

        /* Timer Styles */
        .timer-card.running { background: rgba(0, 122, 51, 0.15); }
        .timer-display { font-size: 3rem; text-align: center; margin: 1rem 0; font-weight: 200; }
        .timer-controls { display: flex; justify-content: center; gap: 10px; }
        
        .progress-container {
            width: 100%;
            height: 10px;
            background: #ddd;
            margin-top: 1.5rem;
            border-radius: 5px;
            overflow: hidden;
        }
        .progress-bar {
            height: 100%;
            width: 100%;
            background: var(--uae-red);
            transition: width 1s linear;
        }

        /* Quote Styles */
        #wisdom-text { font-style: italic; line-height: 1.6; color: #444; }

        /* Footer */
        footer {
            text-align: center;
            padding: 2rem;
            margin-top: 2rem;
            border-top: 4px double var(--gold); /* Sadu-inspired border hint */
            background: var(--glass);
        }

        .arabic-word {
            font-style: italic;
            font-size: 1.2rem;
            color: var(--teal);
        }
    </style>
</head>
<body>

    <header>
        <h1>Al Majlis Digital</h1>
    </header>

    <main class="dashboard-container">
        <!-- Card 1: Daily Karam -->
        <section class="card">
            <h2>Daily Karam</h2>
            <div class="karam-input-group">
                <input type="text" id="karamInput" placeholder="New act of kindness...">
                <button id="addKaram">Add</button>
            </div>
            <ul id="karamList"></ul>
        </section>

        <!-- Card 2: Reflection Clock -->
        <section class="card timer-card" id="timerCard">
            <h2>Reflection Clock</h2>
            <div class="timer-display" id="timerDisplay">25:00</div>
            <div class="timer-controls">
                <button onclick="startTimer()">Start</button>
                <button onclick="pauseTimer()">Pause</button>
                <button onclick="resetTimer()">Reset</button>
            </div>
            <div class="progress-container">
                <div class="progress-bar" id="progressBar"></div>
            </div>
        </section>

        <!-- Card 3: Founders Wisdom -->
        <section class="card">
            <h2>Founders Wisdom</h2>
            <p id="wisdom-text">Loading wisdom...</p>
        </section>
    </main>

    <footer>
        <p class="arabic-word">Asil - Noble/Authentic - Ah-seel</p>
    </footer>

    <script>
        // --- 1. Daily Karam Logic ---
        const karamInput = document.getElementById('karamInput');
        const addBtn = document.getElementById('addKaram');
        const karamList = document.getElementById('karamList');

        let acts = JSON.parse(localStorage.getItem('acts')) || [];

        function renderKaram() {
            karamList.innerHTML = '';
            acts.forEach((act, index) => {
                const li = document.createElement('li');
                li.textContent = act.text;
                if (act.completed) li.classList.add('completed');
                
                li.addEventListener('click', () => {
                    acts[index].completed = !acts[index].completed;
                    saveAndRender();
                });

                li.addEventListener('dblclick', () => {
                    acts.splice(index, 1);
                    saveAndRender();
                });

                karamList.appendChild(li);
            });
        }

        function saveAndRender() {
            localStorage.setItem('acts', JSON.stringify(acts));
            renderKaram();
        }

        addBtn.addEventListener('click', () => {
            if (karamInput.value.trim()) {
                acts.push({ text: karamInput.value, completed: false });
                karamInput.value = '';
                saveAndRender();
            }
        });

        // --- 2. Reflection Clock Logic ---
        let timeLeft = 25 * 60;
        let timerId = null;
        const totalTime = 25 * 60;

        function updateTimerDisplay() {
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            document.getElementById('timerDisplay').textContent = 
                `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
            
            const progressWidth = (timeLeft / totalTime) * 100;
            document.getElementById('progressBar').style.width = `${progressWidth}%`;
        }

        function startTimer() {
            if (timerId) return;
            document.getElementById('timerCard').classList.add('running');
            timerId = setInterval(() => {
                if (timeLeft > 0) {
                    timeLeft--;
                    updateTimerDisplay();
                } else {
                    pauseTimer();
                    alert("Reflection period complete.");
                }
            }, 1000);
        }

        function pauseTimer() {
            clearInterval(timerId);
            timerId = null;
            document.getElementById('timerCard').classList.remove('running');
        }

        function resetTimer() {
            pauseTimer();
            timeLeft = totalTime;
            updateTimerDisplay();
        }

        // --- 3. Founders Wisdom Logic ---
        const quotes = [
            "Future generations will be living in a world that is very different from that to which we are accustomed. It is essential that we prepare them for that new world.",
            "He who does not know his past cannot make the best of his future.",
            "History is a continuous chain of events. The present is only an extension of the past.",
            "The journey for success has no finish line.",
            "We are not among those who rely on high oil prices. We rely on our own ideas.",
            "Wealth is not money. Wealth lies in men. This is where true power lies.",
            "To educate your people and equip them with knowledge as a weapon of self-defence and a means of building their country is a national duty.",
            "A nation without a past is a nation without a present or a future.",
            "Arabism is not a race, it is a way of life, a culture, and a belief.",
            "The real spirit of the union is the spirit of the people."
        ];

        function displayWisdom() {
            const randomQuote = quotes[Math.floor(Math.random() * quotes.length)];
            document.getElementById('wisdom-text').textContent = `"${randomQuote}"`;
        }

        // Initialize
        window.onload = () => {
            renderKaram();
            displayWisdom();
            updateTimerDisplay();
        };
    </script>
</body>
</html>
